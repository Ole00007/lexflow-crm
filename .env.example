# LexFlow CRM — environment variables
# Copy to .env and fill in. NEVER commit .env.

# ── Required (app will not boot without these) ──────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///crm_local.db
# For production: postgresql://user:pass@host:5432/lexflow

# ── Seed passwords (used by /api/auth/seed and boot-time user seeding) ─────
# Each env var must be set or the corresponding user will NOT be created.
SEED_OLEYA00007YAHOO_PASSWORD=change-me
SEED_OLEYA00007GMAIL_PASSWORD=change-me
SEED_SUPERADMINLEXFLOW_PASSWORD=change-me
SEED_ALEGRA007PROTON_PASSWORD=change-me
SEED_MSOKUNEVAINTERNET_PASSWORD=change-me
SEED_OLEYA00007GOOGLE_PASSWORD=change-me
SEED_PREVIEWROMANELLI_PASSWORD=change-me
SEED_FERROLEXFLOW_PASSWORD=change-me
SEED_AVIBELEXFLOW_PASSWORD=change-me
SEED_PAGLIANOLEXFLOW_PASSWORD=change-me
SEED_ROMANELLILEXFLOW_PASSWORD=change-me
SEED_AUDITLEXFLOW_PASSWORD=change-me
SEED_FERROLEXFLOW_PASSWORD=change-me
SEED_CL1ROMANELLI_PASSWORD=change-me
SEED_CL2ROMANELLI_PASSWORD=change-me

# ── Optional ──────────────────────────────────────────────────────────────
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5001
RATELIMIT_STORAGE_URL=memory://

# ── Gantt view (read-only page shell) ─────────────────────────────────────
# GANTT_VIEW_ENABLED=true   # uncomment to enable /gantt page (default: off)
# GANTT_WRITE_ENABLED=false # Layer 3 staff persistence (reserved, not yet built)

# ── Public site URLs (per-tenant "return to website" links) ────────────────
LEXFLOW_SITE_URL=https://lexflow-site.pages.dev/lexflow-index#hero
PAGLIANO_SITE_URL=https://verdant-crumble-021449.netlify.app
